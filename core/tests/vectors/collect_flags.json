    {
      "name": "a routine including itself is visited once",
      "fn": "collectFlags",
      "input": {
        "routines": {
          "r": {
            "id": "r",
            "name": "R",
            "steps": [{"id":"me","type":"routine","routineId":"r","after":[],"when":"loop"}]
