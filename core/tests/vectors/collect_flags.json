    {
      "name": "the same sub-routine twice",
      "fn": "collectFlags",
      "input": {
        "routines": {
          "x": {
            "id": "x",
            "name": "X",
            "steps": [{"id":"a","type":"task","title":"A","after":[],"when":"Abroad"}]
          },
          "r": {
            "id": "r",
            "name": "R",
