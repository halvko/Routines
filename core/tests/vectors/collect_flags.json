    {
      "name": "deduplicated and sorted by character code",
      "fn": "collectFlags",
      "input": {
        "routines": {
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"a","type":"task","title":"A","after":[],"when":"b a10 a2"},
              {"id":"b","type":"task","title":"B","after":[{"id":"a"}],"when":"Zed !b ä a"}
            ]
          }
        },
        "root": "r"
      },
      "expected": ["a","a10","a2","b","zed","ä"]
