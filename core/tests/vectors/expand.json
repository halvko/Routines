{
  "about": "expand: flattening a routine and its sub-routines into the steps of a run.",
  "cases": [
    {
      "name": "hidden steps are bridged out",
      "fn": "expand",
      "input": {
        "routines": {
          "m": {
            "id": "m",
            "name": "Morning",
            "steps": [
              {"id":"wake","type":"task","title":"Wake","after":[]},
              {"id":"gym","type":"task","title":"Gym","after":[{"id":"wake"}],"when":"gym"},
              {"id":"shower","type":"task","title":"Shower","after":[{"id":"wake"},{"id":"gym"}]},
              {"id":"dress","type":"task","title":"Dress","after":[{"id":"shower"}]}
            ]
          }
        },
        "root": "m",
        "flags": {}
      },
      "expected": [
        {"id":"wake","title":"Wake","deps":[],"source":"Morning"},
        {"id":"shower","title":"Shower","deps":["wake"],"source":"Morning"},
        {"id":"dress","title":"Dress","deps":["shower"],"source":"Morning"}
      ]
    },
    {
      "name": "flag puts the gym before the shower",
      "fn": "expand",
      "input": {
        "routines": {
          "m": {
            "id": "m",
            "name": "Morning",
            "steps": [
              {"id":"wake","type":"task","title":"Wake","after":[]},
              {"id":"gym","type":"task","title":"Gym","after":[{"id":"wake"}],"when":"gym"},
              {"id":"shower","type":"task","title":"Shower","after":[{"id":"wake"},{"id":"gym"}]},
              {"id":"dress","type":"task","title":"Dress","after":[{"id":"shower"}]}
            ]
          }
        },
        "root": "m",
        "flags": {"gym":true}
      },
      "expected": [
        {"id":"wake","title":"Wake","deps":[],"source":"Morning"},
        {"id":"gym","title":"Gym","deps":["wake"],"source":"Morning"},
        {"id":"shower","title":"Shower","deps":["wake","gym"],"source":"Morning"},
        {"id":"dress","title":"Dress","deps":["shower"],"source":"Morning"}
      ]
    },
    {
      "name": "negated condition, flag off",
      "fn": "expand",
      "input": {
        "routines": {
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"a","type":"task","title":"A","after":[],"when":"!rain"},
              {"id":"b","type":"task","title":"B","after":[{"id":"a"}]}
            ]
          }
        },
        "root": "r",
        "flags": {}
      },
      "expected": [
        {"id":"a","title":"A","deps":[],"source":"R"},
        {"id":"b","title":"B","deps":["a"],"source":"R"}
      ]
    },
    {
      "name": "negated condition, flag on",
      "fn": "expand",
      "input": {
        "routines": {
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"a","type":"task","title":"A","after":[],"when":"!rain"},
              {"id":"b","type":"task","title":"B","after":[{"id":"a"}]}
            ]
          }
        },
        "root": "r",
        "flags": {"rain":true}
      },
      "expected": [{"id":"b","title":"B","deps":[],"source":"R"}]
    },
    {
      "name": "conditional edge, off",
      "fn": "expand",
      "input": {
        "routines": {
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"a","type":"task","title":"A","after":[]},
              {"id":"b","type":"task","title":"B","after":[]},
              {"id":"c","type":"task","title":"C","after":[{"id":"a"},{"id":"b","when":"late"}]}
            ]
          }
        },
        "root": "r",
        "flags": {}
      },
      "expected": [
        {"id":"a","title":"A","deps":[],"source":"R"},
        {"id":"b","title":"B","deps":[],"source":"R"},
        {"id":"c","title":"C","deps":["a"],"source":"R"}
      ]
    },
    {
      "name": "conditional edge, on",
      "fn": "expand",
      "input": {
        "routines": {
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"a","type":"task","title":"A","after":[]},
              {"id":"b","type":"task","title":"B","after":[]},
              {"id":"c","type":"task","title":"C","after":[{"id":"a"},{"id":"b","when":"late"}]}
            ]
          }
        },
        "root": "r",
        "flags": {"late":true}
      },
      "expected": [
        {"id":"a","title":"A","deps":[],"source":"R"},
        {"id":"b","title":"B","deps":[],"source":"R"},
        {"id":"c","title":"C","deps":["a","b"],"source":"R"}
      ]
    },
    {
      "name": "sub-routines are spliced in between their neighbours",
      "fn": "expand",
      "input": {
        "routines": {
          "bf": {
            "id": "bf",
            "name": "Breakfast",
            "steps": [
              {"id":"coffee","type":"task","title":"Coffee","after":[]},
              {"id":"food","type":"task","title":"Food","after":[]},
              {"id":"eat","type":"task","title":"Eat","after":[{"id":"coffee"},{"id":"food"}]}
            ]
          },
          "d": {
            "id": "d",
            "name": "Day",
            "steps": [
              {"id":"dress","type":"task","title":"Dress","after":[]},
              {"id":"bf","type":"routine","routineId":"bf","after":[{"id":"dress"}]},
              {"id":"leave","type":"task","title":"Leave","after":[{"id":"bf"}]}
            ]
          }
        },
        "root": "d",
        "flags": {}
      },
      "expected": [
        {"id":"dress","title":"Dress","deps":[],"source":"Day"},
        {"id":"bf/coffee","title":"Coffee","deps":["dress"],"source":"Breakfast"},
        {"id":"bf/food","title":"Food","deps":["dress"],"source":"Breakfast"},
        {"id":"bf/eat","title":"Eat","deps":["bf/coffee","bf/food"],"source":"Breakfast"},
        {"id":"leave","title":"Leave","deps":["bf/eat"],"source":"Day"}
      ]
    },
    {
      "name": "the same routine can be included twice",
      "fn": "expand",
      "input": {
        "routines": {
          "x": {"id":"x","name":"X","steps":[{"id":"a","type":"task","title":"A","after":[]}]},
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"one","type":"routine","routineId":"x","after":[]},
              {"id":"two","type":"routine","routineId":"x","after":[{"id":"one"}]}
            ]
          }
        },
        "root": "r",
        "flags": {}
      },
      "expected": [
        {"id":"one/a","title":"A","deps":[],"source":"X"},
        {"id":"two/a","title":"A","deps":["one/a"],"source":"X"}
      ]
    },
    {
      "name": "the same routine twice side by side, then joined",
      "fn": "expand",
      "input": {
        "routines": {
          "bf": {
            "id": "bf",
            "name": "Breakfast",
            "steps": [
              {"id":"coffee","type":"task","title":"Coffee","after":[]},
              {"id":"food","type":"task","title":"Food","after":[]},
              {"id":"eat","type":"task","title":"Eat","after":[{"id":"coffee"},{"id":"food"}]}
            ]
          },
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"up","type":"task","title":"Up","after":[]},
              {"id":"a","type":"routine","routineId":"bf","after":[{"id":"up"}]},
              {"id":"b","type":"routine","routineId":"bf","after":[{"id":"up"}]},
              {"id":"done","type":"task","title":"Done","after":[{"id":"a"},{"id":"b"}]}
            ]
          }
        },
        "root": "r",
        "flags": {}
      },
      "expected": [
        {"id":"up","title":"Up","deps":[],"source":"R"},
        {"id":"a/coffee","title":"Coffee","deps":["up"],"source":"Breakfast"},
        {"id":"a/food","title":"Food","deps":["up"],"source":"Breakfast"},
        {"id":"a/eat","title":"Eat","deps":["a/coffee","a/food"],"source":"Breakfast"},
        {"id":"b/coffee","title":"Coffee","deps":["up"],"source":"Breakfast"},
        {"id":"b/food","title":"Food","deps":["up"],"source":"Breakfast"},
        {"id":"b/eat","title":"Eat","deps":["b/coffee","b/food"],"source":"Breakfast"},
        {"id":"done","title":"Done","deps":["a/eat","b/eat"],"source":"R"}
      ]
    },
    {
      "name": "hidden sub-routine contents are bridged",
      "fn": "expand",
      "input": {
        "routines": {
          "x": {
            "id": "x",
            "name": "X",
            "steps": [{"id":"a","type":"task","title":"A","after":[],"when":"never"}]
          },
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"s","type":"task","title":"S","after":[]},
              {"id":"x","type":"routine","routineId":"x","after":[{"id":"s"}]},
              {"id":"e","type":"task","title":"E","after":[{"id":"x"}]}
            ]
          }
        },
        "root": "r",
        "flags": {}
      },
      "expected": [
        {"id":"s","title":"S","deps":[],"source":"R"},
        {"id":"e","title":"E","deps":["s"],"source":"R"}
      ]
    },
    {
      "name": "empty sub-routine is bridged",
      "fn": "expand",
      "input": {
        "routines": {
          "x": {"id":"x","name":"X","steps":[]},
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"s","type":"task","title":"S","after":[]},
              {"id":"x","type":"routine","routineId":"x","after":[{"id":"s"}]},
              {"id":"e","type":"task","title":"E","after":[{"id":"x"}]}
            ]
          }
        },
        "root": "r",
        "flags": {}
      },
      "expected": [
        {"id":"s","title":"S","deps":[],"source":"R"},
        {"id":"e","title":"E","deps":["s"],"source":"R"}
      ]
    },
    {
      "name": "a hidden sub-routine step is bridged",
      "fn": "expand",
      "input": {
        "routines": {
          "bf": {
            "id": "bf",
            "name": "Breakfast",
            "steps": [
              {"id":"coffee","type":"task","title":"Coffee","after":[]},
              {"id":"food","type":"task","title":"Food","after":[]},
              {"id":"eat","type":"task","title":"Eat","after":[{"id":"coffee"},{"id":"food"}]}
            ]
          },
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"s","type":"task","title":"S","after":[]},
              {"id":"bf","type":"routine","routineId":"bf","after":[{"id":"s"}],"when":"hungry"},
              {"id":"e","type":"task","title":"E","after":[{"id":"bf"}]}
            ]
          }
        },
        "root": "r",
        "flags": {}
      },
      "expected": [
        {"id":"s","title":"S","deps":[],"source":"R"},
        {"id":"e","title":"E","deps":["s"],"source":"R"}
      ]
    },
    {
      "name": "nested sub-routines get nested ids",
      "fn": "expand",
      "input": {
        "routines": {
          "c": {
            "id": "c",
            "name": "Inner",
            "steps": [
              {"id":"x","type":"task","title":"X","after":[]},
              {"id":"y","type":"task","title":"Y","after":[{"id":"x"}]}
            ]
          },
          "b": {
            "id": "b",
            "name": "Middle",
            "steps": [
              {"id":"p","type":"task","title":"P","after":[]},
              {"id":"in","type":"routine","routineId":"c","after":[{"id":"p"}]},
              {"id":"q","type":"task","title":"Q","after":[{"id":"in"}]}
            ]
          },
          "a": {
            "id": "a",
            "name": "Outer",
            "steps": [
              {"id":"start","type":"task","title":"Start","after":[]},
              {"id":"mid","type":"routine","routineId":"b","after":[{"id":"start"}]},
              {"id":"end","type":"task","title":"End","after":[{"id":"mid"}]}
            ]
          }
        },
        "root": "a",
        "flags": {}
      },
      "expected": [
        {"id":"start","title":"Start","deps":[],"source":"Outer"},
        {"id":"mid/p","title":"P","deps":["start"],"source":"Middle"},
        {"id":"mid/in/x","title":"X","deps":["mid/p"],"source":"Inner"},
        {"id":"mid/in/y","title":"Y","deps":["mid/in/x"],"source":"Inner"},
        {"id":"mid/q","title":"Q","deps":["mid/in/y"],"source":"Middle"},
        {"id":"end","title":"End","deps":["mid/q"],"source":"Outer"}
      ]
    },
    {
      "name": "a sub-routine first in its routine has first steps waiting on nothing",
      "fn": "expand",
      "input": {
        "routines": {
          "bf": {
            "id": "bf",
            "name": "Breakfast",
            "steps": [
              {"id":"coffee","type":"task","title":"Coffee","after":[]},
              {"id":"food","type":"task","title":"Food","after":[]},
              {"id":"eat","type":"task","title":"Eat","after":[{"id":"coffee"},{"id":"food"}]}
            ]
          },
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"bf","type":"routine","routineId":"bf","after":[]},
              {"id":"after","type":"task","title":"After","after":[{"id":"bf"}]}
            ]
          }
        },
        "root": "r",
        "flags": {}
      },
      "expected": [
        {"id":"bf/coffee","title":"Coffee","deps":[],"source":"Breakfast"},
        {"id":"bf/food","title":"Food","deps":[],"source":"Breakfast"},
        {"id":"bf/eat","title":"Eat","deps":["bf/coffee","bf/food"],"source":"Breakfast"},
        {"id":"after","title":"After","deps":["bf/eat"],"source":"R"}
      ]
    },
    {
      "name": "routine whose steps are all hidden",
      "fn": "expand",
      "input": {
        "routines": {
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"a","type":"task","title":"A","after":[],"when":"x"},
              {"id":"b","type":"task","title":"B","after":[{"id":"a"}],"when":"y"}
