        },
        "root": "r",
        "flags": {}
      },
      "expected": []
    },
    {
      "name": "routine with no steps",
      "fn": "expand",
      "input": {"routines":{"r":{"id":"r","name":"R","steps":[]}},"root":"r","flags":{}},
      "expected": []
    },
    {
      "name": "a hidden step between several prerequisites and several dependents",
      "fn": "expand",
      "input": {
        "routines": {
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"a","type":"task","title":"A","after":[]},
              {"id":"b","type":"task","title":"B","after":[]},
              {"id":"mid","type":"task","title":"Mid","after":[{"id":"a"},{"id":"b"}],"when":"x"},
              {"id":"c","type":"task","title":"C","after":[{"id":"mid"}]},
              {"id":"d","type":"task","title":"D","after":[{"id":"mid"},{"id":"a"}]}
            ]
          }
        },
        "root": "r",
        "flags": {}
      },
      "expected": [
        {"id":"a","title":"A","deps":[],"source":"R"},
        {"id":"b","title":"B","deps":[],"source":"R"},
        {"id":"c","title":"C","deps":["a","b"],"source":"R"},
        {"id":"d","title":"D","deps":["a","b"],"source":"R"}
      ]
    },
    {
      "name": "bridged prerequisites are not repeated",
      "fn": "expand",
      "input": {
        "routines": {
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"x","type":"task","title":"X","after":[]},
              {"id":"a","type":"task","title":"A","after":[{"id":"x"}],"when":"no"},
              {"id":"b","type":"task","title":"B","after":[{"id":"x"}],"when":"no"},
              {"id":"c","type":"task","title":"C","after":[{"id":"a"},{"id":"b"}]}
            ]
          }
        },
        "root": "r",
        "flags": {}
      },
      "expected": [
