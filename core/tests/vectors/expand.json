      "fn": "expand",
      "input": {
        "routines": {
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"a","type":"task","title":"A","after":[]},
              {"id":"b","type":"task","title":"B","after":[{"id":"a"},{"id":"gone"}]}
            ]
          }
        },
        "root": "r",
        "flags": {}
      },
      "expected": [
        {"id":"a","title":"A","deps":[],"source":"R"},
        {"id":"b","title":"B","deps":["a"],"source":"R"}
      ]
    },
