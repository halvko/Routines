    {
      "name": "seed Morning, no flags",
      "fn": "expand",
      "input": {
        "routines": {
          "breakfast": {
            "id": "breakfast",
            "name": "Breakfast",
            "steps": [
              {"id":"coffee","type":"task","title":"Start the coffee","when":"","after":[]},
              {"id":"food","type":"task","title":"Make food","when":"","after":[]},
              {
                "id": "eat",
                "type": "task",
                "title": "Eat",
                "when": "",
                "after": [{"id":"coffee"},{"id":"food"}]
              },
              {"id":"clean","type":"task","title":"Clean up","when":"","after":[{"id":"eat"}]}
            ]
          },
          "morning": {
            "id": "morning",
            "name": "Morning",
            "steps": [
              {"id":"wake","type":"task","title":"Get out of bed","when":"","after":[]},
              {
                "id": "water",
                "type": "task",
                "title": "Drink a glass of water",
                "when": "",
                "after": [{"id":"wake"}]
              },
              {"id":"gym","type":"task","title":"Gym session","when":"gym","after":[{"id":"water"}]},
              {
                "id": "shower",
                "type": "task",
                "title": "Shower",
                "when": "",
                "after": [{"id":"wake"},{"id":"gym"}]
              },
              {"id":"teeth","type":"task","title":"Brush teeth","when":"","after":[{"id":"shower"}]},
              {"id":"dress","type":"task","title":"Get dressed","when":"","after":[{"id":"teeth"}]},
              {
                "id": "bf",
                "type": "routine",
                "routineId": "breakfast",
                "when": "",
                "after": [{"id":"dress"}]
              },
              {"id":"meds","type":"task","title":"Take vitamins","when":"","after":[{"id":"bf"}]}
            ]
          },
          "travel": {
            "id": "travel",
