    },
    {
      "name": "steps come out after their prerequisites, whatever the listed order",
      "fn": "expand",
      "input": {
        "routines": {
          "r": {
            "id": "r",
            "name": "R",
            "steps": [
              {"id":"c","type":"task","title":"C","after":[{"id":"b"}]},
              {"id":"b","type":"task","title":"B","after":[{"id":"a"}]},
              {"id":"a","type":"task","title":"A","after":[]}
            ]
          }
        },
        "root": "r",
        "flags": {}
      },
      "expected": [
        {"id":"a","title":"A","deps":[],"source":"R"},
        {"id":"b","title":"B","deps":["a"],"source":"R"},
        {"id":"c","title":"C","deps":["b"],"source":"R"}
      ]
    },
    {
