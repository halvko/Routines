{
  "about": "crossLinks, hasCycle, and ready/waiting with runs placed before or after steps of other runs.",
  "cases": [
    {
      "name": "after: links each first step to the other run's step",
      "fn": "crossLinks",
      "input": {
        "runs": {
          "day": {
            "id": "day",
            "name": "DAY",
            "flags": {},
            "nodes": [
              {"id":"wake","title":"WAKE","deps":[],"source":"x"},
              {"id":"commute","title":"COMMUTE","deps":["wake"],"source":"x"},
              {"id":"home","title":"HOME","deps":["commute"],"source":"x"}
            ],
            "done": {},
            "startedAt": 1700000000000
          },
          "gym": {
            "id": "gym",
            "name": "GYM",
            "flags": {},
            "nodes": [
              {"id":"unpack","title":"UNPACK","deps":[],"source":"x"},
              {"id":"wash","title":"WASH","deps":["unpack"],"source":"x"},
              {"id":"bottle","title":"BOTTLE","deps":[],"source":"x"}
            ],
            "done": {},
            "startedAt": 1700000000000,
            "attach": {"rel":"after","run":"day","id":"commute"}
          }
        }
      },
      "expected": [
        {"run":"gym","id":"unpack","from":[{"run":"day","id":"commute"}]},
        {"run":"gym","id":"bottle","from":[{"run":"day","id":"commute"}]}
      ]
    },
    {
      "name": "before: links the other run's step to each last step",
      "fn": "crossLinks",
      "input": {
        "runs": {
          "day": {
            "id": "day",
            "name": "DAY",
            "flags": {},
            "nodes": [
              {"id":"wake","title":"WAKE","deps":[],"source":"x"},
              {"id":"leave","title":"LEAVE","deps":["wake"],"source":"x"}
            ],
            "done": {},
            "startedAt": 1700000000000
          },
          "pack": {
            "id": "pack",
            "name": "PACK",
            "flags": {},
            "nodes": [
              {"id":"shoes","title":"SHOES","deps":[],"source":"x"},
              {"id":"towel","title":"TOWEL","deps":[],"source":"x"},
              {"id":"close","title":"CLOSE","deps":["shoes","towel"],"source":"x"}
            ],
            "done": {},
            "startedAt": 1700000000000,
            "attach": {"rel":"before","run":"day","id":"leave"}
          }
        }
      },
      "expected": [{"run":"day","id":"leave","from":[{"run":"pack","id":"close"}]}]
    },
